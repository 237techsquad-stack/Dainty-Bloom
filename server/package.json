{
  "name": "dainty-bloom-server",
  "version": "1.0.0",
  "private": true,
  "description": "Dainty Bloom REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "admin:provision-initial": "tsx src/scripts/provisionInitialAdmin.ts",
    "categories:sync": "tsx src/scripts/syncCategories.ts",
    "db:sync-indexes": "tsx src/scripts/syncIndexes.ts",
    "routes:list": "tsx src/scripts/listRoutes.ts",
    "cleanup:uploads": "tsx src/scripts/cleanupUploads.ts",
    "artwork:integrity": "tsx src/scripts/checkArtworkIntegrity.ts",
    "artwork:migrate:cloudinary": "tsx src/scripts/migrateArtworkToCloudinary.ts",
    "expire:unpaid": "tsx src/scripts/expireUnpaidOrders.ts",
    "settings:profile": "tsx src/scripts/applyBusinessProfile.ts",
    "currency:migrate:usd-to-gbp": "tsx src/scripts/migrateCurrencyUsdToGbp.ts",
    "lint": "eslint .",
    "test": "vitest run tests"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^5.11.2",
    "file-type": "^22.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pino": "^9.6.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.19.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^4.1.11"
  }
}
