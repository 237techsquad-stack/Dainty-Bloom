NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/dainty-bloom
CLIENT_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECRET=replace-with-a-random-cookie-secret-at-least-32-characters
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
TRUST_PROXY=false
BCRYPT_COST=12
PASSWORD_RESET_TTL=15m
CART_MAX_QUANTITY=99
UPLOAD_MAX_BYTES=10485760
# Use cloudinary only after configuring CLOUDINARY_URL or all three CLOUDINARY_* values below.
STORAGE_DRIVER=local
STORAGE_PRIVATE_DIR=./storage/private
UPLOAD_SIGNING_SECRET=replace-with-a-random-signing-secret-at-least-32-characters
PRODUCT_IMAGE_MAX_BYTES=10485760
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_CHECKOUT_EXPIRY_MINUTES=30
UNPAID_ORDER_EXPIRY_HOURS=48
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DEFAULT_CURRENCY=GBP
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
CONTACT_RECIPIENT_EMAIL=
# Gmail SMTP: use smtp.gmail.com, port 587, SMTP_SECURE=false (STARTTLS).
# The sender address must be verified as an allowed Gmail/Workspace alias.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
